[Unit]
Description=FireLaunch native Vega build queue worker (separate from staging API)
After=postgresql.service
RequiresMountsFor=/var/lib/firelaunch-build

[Service]
Type=simple
User=firelaunch-build
Group=firelaunch-export
EnvironmentFile=/etc/firelaunch-build/worker.env
ExecStart=/usr/bin/flock -n /var/lib/firelaunch-build/worker.lock /opt/firelaunch-build-app/node/bin/node /opt/firelaunch-build-app/apps/server/dist/native-build-worker.js
Restart=on-failure
RestartSec=10
WorkingDirectory=/opt/firelaunch-build-app
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# bubblewrap must mount a private /proc. The child masks /proc/sys with an empty
# tmpfs, while this unprivileged supervisor has no capabilities or host egress.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
InaccessiblePaths=/srv/firelaunch /var/backups /etc/firelaunch /home /root
ReadWritePaths=/var/lib/firelaunch-build
RestrictAddressFamilies=AF_UNIX AF_NETLINK
MemoryMax=2G
CPUQuota=100%
TasksMax=128
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
