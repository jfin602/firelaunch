# FireLaunch staging - AWS values from deployed CloudFormation outputs (no secrets).
# Variables marked TODO depend on application code or a later client decision.
FIRELAUNCH_MEDIA_AWS_REGION=us-east-2
FIRELAUNCH_MEDIA_ORIGINALS_BUCKET=firelaunch-staging-originals-363242105231-use2
FIRELAUNCH_MEDIA_DELIVERY_BUCKET=firelaunch-staging-media-363242105231-use2
FIRELAUNCH_MEDIA_CLOUDFRONT_ORIGIN=https://dl2jzii5bnotd.cloudfront.net
FIRELAUNCH_MEDIA_CLOUDFRONT_HOSTS=dl2jzii5bnotd.cloudfront.net
FIRELAUNCH_MEDIACONVERT_ACCOUNT=363242105231
FIRELAUNCH_MEDIACONVERT_QUEUE_ARN=arn:aws:mediaconvert:us-east-2:363242105231:queues/firelaunch-staging-encode
FIRELAUNCH_MEDIACONVERT_ROLE_ARN=arn:aws:iam::363242105231:role/firelaunch/firelaunch-mediaconvert
FIRELAUNCH_MEDIACONVERT_EVENT_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/363242105231/firelaunch-staging-mediaconvert-events
AWS_REGION=us-east-2
AWS_PROFILE=firelaunch-staging-app
# Publisher credentials: the app must AssumeRole into this ARN for publication only.
# The variable NAME is defined by the application code (not invented here):
#   <publisher-role variable> = arn:aws:iam::363242105231:role/firelaunch/firelaunch-staging-publisher
# Staging output prefix written by MediaConvert: staged/   Published prefix: delivery/
